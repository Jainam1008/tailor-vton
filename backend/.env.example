# Copy this file to backend/.env and fill in your own values (backend/.env
# is already excluded from git by the root .gitignore - never commit it).

# The "VTONModel.web" URL printed by `modal deploy backend/app.py` - the
# base address for /warmup and /tryon (NOT the separate /health URL).
TRYON_BASE_URL=https://your-workspace--tailor-vton-backend-vtonmodel-web.modal.run

# The KIOSK_TOKEN value you set with:
#   modal secret create vton-secrets KIOSK_TOKEN=... ALLOWED_ORIGIN=...
KIOSK_TOKEN=replace-with-your-kiosk-token
