# Cloudflare Pages security headers - https://developers.cloudflare.com/pages/configuration/headers/
#
# IMPORTANT: the Content-Security-Policy line below hard-codes your Modal
# backend's URL (the same one you put in kiosk/config.js as API_URL) in
# connect-src, because a CSP header can't read config.js at request time -
# it has to already know which origins are allowed. If you ever redeploy
# the backend to a different Modal workspace/URL, update BOTH config.js
# AND the connect-src value below, then redeploy the kiosk.
#
# Permissions-Policy: camera is allowed for this site only (the camera
# screen needs it); microphone/geolocation are denied outright since the
# kiosk never uses them.
#
# Content-Security-Policy: 'self' covers our own scripts/styles/images,
# plus the two external hosts actually used - Google Fonts (style.css
# @imports its stylesheet from fonts.googleapis.com, which serves the
# actual font files from fonts.gstatic.com) and the Modal backend
# (connect-src, for the /warmup and /tryon fetch calls). Result images are
# data: URIs (img-src data:), never fetched from a URL.

/*
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), fullscreen=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://jainam-7701--tailor-vton-backend-vtonmodel-web.modal.run; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none';
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
